<Window x:Class="Cheat_Inspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cheat-Inspector"
        Width="1000"
        Height="620"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="Cascadia Code">

    <Window.Resources>

        <SolidColorBrush x:Key="WindowBackground" Color="#08080B"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="#9147FF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F0FA"/>

        <Storyboard x:Key="WindowAppear">
            <DoubleAnimation Storyboard.TargetName="MainBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="WindowTransform"
                             Storyboard.TargetProperty="Y"
                             From="6" To="0"
                             Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A69BB5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale"
                                                ScaleX="1"
                                                ScaleY="1"/>
                            </Border.RenderTransform>

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="ButtonBackground"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#42216B"
                                                Duration="0:0:0.16"/>

                                            <ColorAnimation
                                                Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                                                To="#D8B8FF"
                                                Duration="0:0:0.16"/>

                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="1.06"
                                                Duration="0:0:0.16"/>

                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="1.06"
                                                Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="ButtonBackground"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#00000000"
                                                Duration="0:0:0.18"/>

                                            <ColorAnimation
                                                Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                                                To="#A69BB5"
                                                Duration="0:0:0.18"/>

                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="1"
                                                Duration="0:0:0.18"/>

                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="1"
                                                Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="#5B2A91"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource WindowAppear}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid Background="Transparent" Margin="8">

        <Border x:Name="MainBorder"
                Background="{StaticResource WindowBackground}"
                BorderBrush="#493064"
                BorderThickness="1"
                CornerRadius="16"
                ClipToBounds="True"
                Opacity="1">

            <Border.RenderTransform>
                <TranslateTransform x:Name="WindowTransform" Y="0"/>
            </Border.RenderTransform>

            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="62"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#0A0A0E"
                        CornerRadius="15,15,0,0"/>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Cheat-Inspector"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="24,0,0,0"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource CloseButtonStyle}"
                            Content="×"
                            ToolTip="Закрыть"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center"
                            Click="CloseButton_Click"/>
                </Grid>

                <Border Grid.Row="1"
                        Background="#1B1423"/>

                <Border Grid.Row="2"
                        Background="#08080B"
                        CornerRadius="0,0,15,15"
                        ClipToBounds="True">
                    <Grid x:Name="ContentArea" Margin="20"/>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>